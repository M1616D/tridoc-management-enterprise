{
  "name": "tridoc-management-enterprise",
  "version": "1.1.0",
  "description": "Professional Smart Document Management & Full-Text Search System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "publish": "electron-builder --win --publish always"
  },
  "keywords": [
    "electron",
    "document-management",
    "sqlite",
    "fts5",
    "tesseract"
  ],
  "author": "TriVerse Studio Software Solution",
  "license": "Proprietary",
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "mammoth": "^1.6.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.0.5",
    "electron-updater": "^6.1.8"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.triverse.tridoc",
    "productName": "TriDoc Enterprise",
    "copyright": "Copyright © 2025 TriVerse Studio Software Solution",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.bin",
      "!dist",
      "!*.log"
    ],
    "extraResources": [
      "locales/**",
      "tessdata/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "publisherName": "TriVerse Studio Software Solution"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "license.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TriDoc Enterprise",
      "include": "installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "M1616D",
      "repo": "tridoc-management-enterprise",
      "releaseType": "release"
    }
  }
}